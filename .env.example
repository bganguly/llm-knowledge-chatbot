# Python API (api/main.py)
ANTHROPIC_API_KEY=sk-ant-...
# Local dev / solo deploy only: resolved on the machine that runs deploy.sh and copied
# into the Docker build context. For a shared team setup this must be a common location
# (e.g. a GCS bucket synced before the build, or a Git LFS path available to all clones).
SNAPSHOTS_PATH=/absolute/path/to/snapshots

# Cloudflare Worker secrets (set once via: wrangler secret put <VAR>; persists across deploys)
# Never commit actual values — git push handles code, secrets are set separately.
API_URL=https://<cloud-run-service>.run.app
KNOWLEDGE_BASE_URL=https://www.<domain>.com

# GCP / Cloud Run deploy (used by deploy.sh — copy to .env.gcp)
GCP_PROJECT=<your-gcp-project>
GCP_REGION=us-central1
AR_REPO=<artifact-registry-repo-name>
BACKEND_URL=https://<cloud-run-service>.run.app
